{# MyInvoice.cz — PDF šablona faktury (mPDF + Twig) #}
{# Variables: invoice (full hydrated), supplier, client, bank, qr_data_uri, locale #}
{#
   Layout stojí na dvousloupcové mřížce se svislou dělicí linkou (viz styles/invoice.css).
   Vlevo dodavatel a jeho kontakty, vpravo typ dokladu s číslem v rámečku a pod ním
   odběratel. Následuje platební pruh přes celou šířku, tabulka položek, a dole QR
   vlevo proti částce k úhradě vpravo.

   Doklad je achromatický — o barvu se tu nepokoušej, typ dokladu říká jeho popisek.
#}
<!doctype html>
<html lang="{{ locale|default('cs') }}">
<head>
<meta charset="utf-8">
<title></title>
<style>{{ css|raw }}</style>
</head>
<body>

{# Symbol měny pro celkovou částku. Kód ISO zůstává všude jinde (v tabulce položek
   se měna neopakuje vůbec) — symbol nese jen ta jediná částka, kterou příjemce platí. #}
{% set currency_symbols = {'CZK': 'Kč', 'EUR': '€', 'USD': '$', 'GBP': '£', 'PLN': 'zł', 'HUF': 'Ft'} %}
{% set currency_symbol = currency_symbols[invoice.currency]|default(invoice.currency) %}

{# ─── PATIČKA (každá stránka) ───
   Zápis v rejstříku, kdo doklad vystavil, attribution a číslo strany. „Vystavil(a)"
   bere autora dokladu (invoices.created_by), NE aktuálně přihlášeného uživatele:
   PDF se cachuje a servíruje opakovaně, takže údaj vázaný na toho, kdo si ho zrovna
   stáhl, by na dokladu lhal každému dalšímu. #}
<htmlpagefooter name="docfooter">
  <table class="doc-footer">
    {% if supplier.commercial_register %}
    <tr>
      <td colspan="3" class="footer-register">{{ supplier.commercial_register }}</td>
    </tr>
    {% endif %}
    <tr{% if supplier.commercial_register %} class="has-register"{% endif %}>
      <td class="footer-issued">
        {%- if issued_by -%}
          {{ t('Vystavil(a)', 'Issued by') }}: {{ issued_by }}, {{ invoice.issue_date|date(date_format) }}
        {%- endif -%}
      </td>
      <td class="footer-attribution">
        <span class="page-attribution">
          {%- if locale == 'en' -%}
            Issued with the <a href="https://myucto.cz/">MyÚčto.cz</a> accounting system
          {%- else -%}
            Vystaveno v účetním systému <a href="https://myucto.cz/">MyÚčto.cz</a>
          {%- endif -%}
        </span>
      </td>
      <td class="footer-page">{{ t('Strana', 'Page') }} {PAGENO}/{nbpg}</td>
    </tr>
  </table>
</htmlpagefooter>
<sethtmlpagefooter name="docfooter" value="on" />

{# ─── HLAVIČKA + STRANY ─── #}
<table class="head{% if invoice.invoice_type == 'cancellation' %} cancellation{% endif %}">
  <tr>
    {# Přiložený ISDOC se na doklad NETISKNE. Je to strojová příloha (mPDF ji
       přidává přes SetAssociatedFiles() do PDF/A-3 /AF + /Names /EmbeddedFiles)
       a prohlížeč ji ohlásí sponkou v seznamu příloh — na papíře by badge „ISDOC"
       byl jen šum nad jménem dodavatele. Předloha ho taky nemá. #}
    <td class="head-left">
      <div class="party-label">{{ t('Dodavatel', 'Supplier') }}</div>
      <div class="party-name">{{ supplier.company_name }}</div>
      {% if supplier.display_name and supplier.display_name != supplier.company_name %}
        <div>{{ supplier.display_name }}</div>
      {% endif %}
      <div>{{ supplier.street }}</div>
      <div>{{ supplier.zip }} {{ supplier.city }}</div>
      <div>{{ locale == 'en' ? supplier.country_name_en : supplier.country_name_cs }}</div>
      <div class="spacer-4">&nbsp;</div>
      <div class="ic-dic">
        {% if supplier.ic %}{{ t('IČ', 'Reg. No.') }}: {{ supplier.ic }}{% endif %}
        {# SK plátce DPH (#120): DIČ s prefixem SK je „IČ DPH"; vedle něj patří DIČ = totéž
           bez prefixu (supplier skdic nevede, SK DIČ se od IČ DPH liší jen prefixem).
           Neplátce má v poli jen číslo bez prefixu → spadne do else a tiskne se jako DIČ. #}
        {% if supplier.dic %}
          {% if supplier.dic|upper starts with 'SK' %}
            <span class="dic-gap">{{ t('DIČ', 'Tax ID') }}: {{ supplier.dic|slice(2) }}</span><br>
            {{ t('IČ DPH', 'VAT ID') }}: {{ supplier.dic }}
          {% else %}
            <span class="dic-gap">{{ t('DIČ', 'VAT ID') }}: {{ supplier.dic }}</span>
          {% endif %}
        {% endif %}
      </div>
      {# Identifikovaná osoba (§ 6g–6l, #94) na zahraničním RC dokladu řádek
         „Nejsme plátci DPH" nemá — matl by příjemce, který má daň samovyměřit;
         nahrazuje ho RC klauzule + DIČ. Tuzemské faktury IO řádek mají (pravdivý). #}
      {% if not supplier.is_vat_payer and not (supplier.is_identified|default(false) and invoice.reverse_charge) %}
        <div>{{ t('Nejsme plátci DPH', 'Not a VAT payer') }}</div>
      {% endif %}

      {% if supplier.email or supplier.phone %}
      <table class="contact">
        <tr>
          <td colspan="2"><strong>{{ t('Kontaktní údaje', 'Contact details') }}</strong></td>
        </tr>
        {% if supplier.email %}
        <tr>
          <td class="contact-label">{{ t('E-mail', 'E-mail') }}:</td>
          <td>{{ supplier.email }}</td>
        </tr>
        {% endif %}
        {% if supplier.phone %}
        <tr>
          <td class="contact-label">{{ t('Telefon', 'Phone') }}:</td>
          <td>{{ supplier.phone }}</td>
        </tr>
        {% endif %}
      </table>
      {% endif %}
    </td>

    <td class="head-right">
      <table class="doc-title">
        <tr>
          <td><div class="doc-type">{{ doc_type_label }}</div></td>
          <td class="doc-number">
            {% if invoice.varsymbol %}
            <table class="num-box"><tr><td>{{ invoice.varsymbol }}</td></tr></table>
            {# Čárový kód s číslem dokladu — strojové čtení při zakládání došlé pošty
               u příjemce. C128B zvládne i číslo s pomlčkou (formát 2026-0042).
               `size` a `height` jsou proměřené podle předlohy (65.3 × 7.4 pt) —
               mPDF je bere jen z atributů tagu, ze stylopisu ne. Nižší kód se
               čtečce hůř trefuje a na stránce vypadá jako šedý proužek. #}
            <table class="barcode-wrap"><tr><td>
              <barcode code="{{ invoice.varsymbol }}" type="C128B" size="0.45" height="0.61" />
            </td></tr></table>
            {% endif %}
            {% if parent_varsymbol %}
              <div class="parent-ref">{{ t('k faktuře', 'to invoice') }} {{ parent_varsymbol }}</div>
            {% endif %}
          </td>
        </tr>
      </table>

      <div class="head-gap">&nbsp;</div>

      {# Blok odběratele stojí ve VLASTNÍ jednobuňkové tabulce — viz .party-block
         ve stylopisu. Bez ní by mu mPDF sebral proklad. #}
      <table class="party-block"><tr><td>
      <div class="party-label">{{ t('Odběratel', 'Customer') }}</div>
      <div class="party-name">{{ client.company_name }}</div>
      {% if client.first_name or client.last_name %}
        <div>{{ client.first_name }} {{ client.last_name }}</div>
      {% endif %}
      <div>{{ client.street }}</div>
      <div>{{ client.zip }} {{ client.city }}</div>
      <div>{{ locale == 'en' ? client.country_name_en : client.country_name_cs }}</div>
      <div class="spacer-4">&nbsp;</div>
      <div class="ic-dic">
        {# Národní daňové číslo (#120): SK DIČ / DE+AT Steuernummer / PL NIP / HU Adószám —
           nativní label podle země klienta. `dic` zůstává VAT ID s prefixem (u SK = IČ DPH,
           u SK se proto VAT řádek labeluje „IČ DPH"). Pořadí dle SK praxe: IČO, DIČ, IČ DPH.
           Starší SK snapshoty tax_number nemají → odvodíme z IČ DPH oseknutím prefixu
           (SK DIČ se od IČ DPH liší jen prefixem; u DE/PL/HU odvodit nejde). #}
        {% set tax_no_labels = {'SK': 'DIČ', 'DE': 'Steuernummer', 'AT': 'Steuernummer', 'PL': 'NIP', 'HU': 'Adószám'} %}
        {% set client_dic_sk = client.dic and (client.dic|upper starts with 'SK') %}
        {% set client_tax_no = client.tax_number|default(client_dic_sk ? client.dic|slice(2) : '') %}
        {% if client.ic %}{{ t('IČ', 'Reg. No.') }}: {{ client.ic }}{% endif %}
        {% if client_tax_no %}
          <span class="dic-gap">{{ tax_no_labels[client.country_iso2|default('')]|default(client_dic_sk ? 'DIČ' : t('Daňové číslo', 'Tax No.')) }}: {{ client_tax_no }}</span>
          {%- if client.dic %}<br>{% endif %}
        {% endif %}
        {% if client.dic %}
          <span class="dic-gap">{{ client_dic_sk ? t('IČ DPH', 'VAT ID') : t('DIČ', 'VAT ID') }}: {{ client.dic }}</span>
        {% endif %}
      </div>
      </td></tr></table>
    </td>
  </tr>
  {# Způsob úhrady je DRUHÝ ŘÁDEK téže tabulky, ne samostatný blok pod ní: dělicí
     linka je border levé buňky, takže takhle jde svisle přes obě části bez přetržení,
     a mPDF má jistotu, že řádek nezačne dřív, než skončí blok odběratele vedle. #}
  <tr>
    <td class="paymethod-left">
      <span class="paymethod-label">{{ t('Způsob úhrady', 'Payment method') }}:</span>
      <span class="paymethod-value">
        {%- if payment_method == 'card' -%}{{ t('Platební karta', 'Card') }}
        {%- elseif payment_method == 'cash' -%}{{ t('Hotově', 'Cash') }}
        {%- elseif payment_method == 'other' -%}{{ t('Jiný způsob', 'Other') }}
        {%- else -%}{{ t('Převodem', 'Bank transfer') }}{%- endif -%}
      </span>
    </td>
    <td></td>
  </tr>
</table>

{# ─── PLATEBNÍ PRUH ───
   Bankovní účet | Symbol | Datum. Pruh je na dokladu vždy — i u hotovosti nebo
   uhrazené faktury, kde v prvním sloupci místo účtu stojí věta o způsobu úhrady.
   Dvě věci, kvůli kterým příjemce doklad otevírá (kam a do kdy), tak mají stálé místo. #}
{% set _vs = payment_varsymbol|default(invoice.varsymbol) %}
{% set _show_bank = bank and not is_paid and payment_method == 'bank_transfer' %}
<table class="payband">
  <tr>
    <td class="payband-bank">
      {% if _show_bank %}
        <div class="payband-title">{{ t('Bankovní účet', 'Bank account') }}</div>
        {% if bank.account_number %}
          <div class="payband-line">{{ bank.account_number }}{% if bank.bank_code %}/{{ bank.bank_code }}{% endif %}</div>
        {% endif %}
        {# IBAN po čtveřicích — tak ho sází předloha i banky. Přepis z papíru se
           takhle dá kontrolovat po skupinách, souvislých 24 znaků ne. #}
        {% if bank.iban %}
          <div class="payband-line">IBAN: {{ bank.iban|replace({' ': ''})|split('', 4)|join(' ') }}</div>
        {% endif %}
        {% if bank.bic %}
          <div class="payband-line">SWIFT: {{ bank.bic }}</div>
        {% endif %}
      {% else %}
        <div class="payband-title">{{ t('Úhrada', 'Payment') }}</div>
        <div class="payband-note">
          {%- if is_paid -%}
            {{ t('Uhrazeno', 'Paid') }}
            {%- if invoice.paid_at %} {{ invoice.paid_at|date(date_format) }}{% endif -%}
            . {{ t('Neplaťte prosím znovu.', 'Please do not pay again.') }}
          {%- elseif payment_method == 'card' -%}
            {{ t('Platební kartou. Bankovní převod ani QR se nepoužije.', 'By card. Bank transfer and QR are not used.') }}
          {%- elseif payment_method == 'cash' -%}
            {{ t('V hotovosti.', 'In cash.') }}
          {%- else -%}
            {{ t('Dohodnutým způsobem.', 'As agreed.') }}
          {%- endif -%}
        </div>
      {% endif %}
    </td>

    <td class="payband-symbol">
      <div class="payband-title">{{ t('Symbol', 'Symbol') }}</div>
      <table class="payband-pairs">
        {% if _vs %}
        <tr>
          <td class="pair-label">{{ t('variabilní', 'variable') }}:</td>
          <td class="pair-value">{{ _vs }}</td>
        </tr>
        {% endif %}
        <tr>
          <td class="pair-label">{{ t('konstantní', 'constant') }}:</td>
          <td class="pair-value">{{ invoice.constant_symbol|default('0308') }}</td>
        </tr>
        <tr>
          <td class="pair-label">{{ t('měna', 'currency') }}:</td>
          <td class="pair-value">{{ invoice.currency }}</td>
        </tr>
      </table>
    </td>

    <td class="payband-date">
      <div class="payband-title">{{ t('Datum', 'Date') }}</div>
      <table class="payband-pairs">
        <tr>
          <td class="pair-label">{{ t('vystavení', 'issued') }}:</td>
          <td class="pair-value">{{ invoice.issue_date|date(date_format) }}</td>
        </tr>
        {% if supplier.is_vat_payer and invoice.tax_date and invoice.invoice_type != 'proforma' %}
        <tr>
          <td class="pair-label">{{ t('DUZP', 'tax point') }}:</td>
          <td class="pair-value">{{ invoice.tax_date|date(date_format) }}</td>
        </tr>
        {% endif %}
        <tr>
          <td class="pair-label">{{ t('splatnosti', 'due') }}:</td>
          <td class="pair-value">{{ invoice.due_date|date(date_format) }}</td>
        </tr>
      </table>
    </td>
  </tr>
</table>

{# ─── ÚVODNÍ VĚTA ─── #}
<div class="intro">
  {% if invoice.invoice_type == 'proforma' %}
    {{ t('Žádáme Vás o úhradu zálohy za níže uvedené plnění:', 'We kindly ask you to pay the advance for the supply listed below:') }}
  {% elseif invoice.invoice_type == 'credit_note' %}
    {{ t('Opravujeme Vám níže uvedené položky:', 'We are correcting the items listed below:') }}
  {% else %}
    {{ t('Fakturujeme Vám za dodané zboží či služby:', 'We are invoicing you for the goods or services supplied:') }}
  {% endif %}
</div>

{% if invoice.note_above_items %}
<div class="note note-above">{{ invoice.note_above_items|nl2br }}</div>
{% endif %}

{# ─── POLOŽKY ─── #}
{% set _zakazka_meta = invoice.project_name or invoice.project_number or invoice.contract_number %}
<table class="items">
  <thead>
    <tr>
      {% if supplier.is_vat_payer %}
      <th style="width:44%">{{ t('Označení dodávky', 'Description of supply') }}</th>
      <th class="num nowrap" style="width:8%">{{ t('Počet', 'Qty') }}</th>
      <th class="nowrap" style="width:5%">{{ t('m. j.', 'unit') }}</th>
      <th class="num nowrap" style="width:14%">{{ t('Cena za m.j.', 'Unit price') }}</th>
      <th class="center nowrap" style="width:6%">{{ t('DPH', 'VAT') }}</th>
      <th class="num nowrap" style="width:11%">{{ t('Bez DPH', 'Excl. VAT') }}</th>
      <th class="num nowrap" style="width:12%">{{ t('Celkem', 'Total') }}</th>
      {% else %}
      <th style="width:62%">{{ t('Označení dodávky', 'Description of supply') }}</th>
      <th class="num nowrap" style="width:8%">{{ t('Počet', 'Qty') }}</th>
      <th class="nowrap" style="width:5%">{{ t('m. j.', 'unit') }}</th>
      <th class="num nowrap" style="width:12%">{{ t('Cena za m.j.', 'Unit price') }}</th>
      {# RC doklad neplátce/IO: částky jsou základ daně (samovyměří odběratel) —
         sloupec to musí říct, neutrální „Celkem" by byl nejednoznačný. #}
      {% if invoice.reverse_charge %}
      <th class="num nowrap" style="width:13%">{{ t('Celkem bez DPH', 'Total excl. VAT') }}</th>
      {% else %}
      <th class="num nowrap" style="width:13%">{{ t('Celkem', 'Total') }}</th>
      {% endif %}
      {% endif %}
    </tr>
  </thead>
  <tbody>
    {% for item in invoice.items %}
    <tr{% if item.item_kind == 'discount' %} class="discount-row"{% endif %}>
      {# Když má faktura výkaz víceprací, je proklikávací (podtržený) odkaz na stránku
         s výkazem JEN položka výkazu — tj. ta, jejíž popis odpovídá názvu výkazu
         (work_report.title), s pojistkou na klíčové slovo „výkaz" / „work report".
         Ostatní položky i slevové řádky zůstávají běžným textem. mPDF dělá interní
         skok na <a name="work-report">. #}
      {%- set _wr_d = item.description|trim|lower -%}
      {%- set _mat_title = work_report.material_title|default('')|trim|lower -%}
      {%- set _is_mat_item = work_report and work_report.material_total > 0 and item.item_kind != 'discount'
            and _mat_title != '' and _wr_d == _mat_title -%}
      {%- set _is_wr_item = work_report and not _is_mat_item and item.item_kind != 'discount'
            and (_wr_d == (work_report.title|default('')|trim|lower)
                 or 'výkaz' in _wr_d or 'work report' in _wr_d) -%}
      <td>
        {%- if _is_wr_item -%}
          <a href="#work-report" class="wr-link">{{ item.description|nl2br }}</a>
        {%- elseif _is_mat_item -%}
          <a href="#work-report-material" class="wr-link">{{ item.description|nl2br }}</a>
        {%- else -%}
          {{ item.description|nl2br }}
        {%- endif -%}
      </td>
      {% if item.item_kind == 'discount' %}
      <td></td><td></td><td></td>
      {% else %}
      {# Počet a cena za m.j. na 4 desetinná místa — tolik jich nese ISDOC i předloha;
         u hodinových sazeb a přepočtů jednotek se na méně místech ztrácí přesnost. #}
      <td class="num nowrap">{% if item.duration_display is defined and item.duration_display is not null %}{{ item.duration_display }}{% else %}{{ item.quantity|number_format(4, decimal_sep, thousand_sep) }}{% endif %}</td>
      {# Balení (issue #17): řádek v kartonech dostane rozpis na základní jednotky
         karty, pokud ho firma nemá v nastavení vypnutý (InvoicePdfRenderer::withBaseQuantity). #}
      <td>{{ item.unit }}{% if item.base_qty is defined and item.base_qty is not null %}<br><span class="base-qty">({{ t('celkem', 'total') }} {{ item.base_qty|number_format(item.base_qty == item.base_qty|round(0) ? 0 : (item.base_qty == item.base_qty|round(1) ? 1 : (item.base_qty == item.base_qty|round(2) ? 2 : 3)), decimal_sep, thousand_sep) }}&nbsp;{{ item.base_unit }})</span>{% endif %}</td>
      {# V režimu „ceny s DPH" nese unit_price_without_vat brutto; pro zobrazení dopočítáme
         skutečné netto z řádkového základu (total_without_vat / množství). #}
      <td class="num nowrap">{{ item.pdf_unit_price|default(invoice.prices_include_vat and item.quantity != 0 ? item.total_without_vat / item.quantity : item.unit_price_without_vat)|number_format(4, decimal_sep, thousand_sep) }}</td>
      {% endif %}
      {% if supplier.is_vat_payer %}
      <td class="center nowrap">{{ item.vat_rate_snapshot|number_format(item.vat_rate_snapshot == item.vat_rate_snapshot|round(0) ? 0 : 2, decimal_sep, thousand_sep) }}&nbsp;%</td>
      <td class="num nowrap">{{ item.total_without_vat|number_format(2, decimal_sep, thousand_sep) }}</td>
      <td class="num nowrap amount">{{ item.total_with_vat|number_format(2, decimal_sep, thousand_sep) }}</td>
      {% else %}
      <td class="num nowrap amount">{{ item.total_without_vat|number_format(2, decimal_sep, thousand_sep) }}</td>
      {% endif %}
    </tr>
    {% endfor %}
  </tbody>
</table>

{% if _zakazka_meta %}
<div class="note">
  {%- if invoice.project_name %}{{ t('Zakázka', 'Project') }}: {{ invoice.project_name }}{% endif -%}
  {%- if invoice.project_number %}{% if invoice.project_name %} · {% endif %}{{ t('Vaše číslo', 'Your order no.') }}: {{ invoice.project_number }}{% endif -%}
  {%- if invoice.contract_number %}{% if invoice.project_name or invoice.project_number %} · {% endif %}{{ t('Vaše smlouva', 'Your contract') }}: {{ invoice.contract_number }}{% endif -%}
</div>
{% endif %}

{% if invoice.reverse_charge %}
<div class="note rc-note">
  {# Tuzemský RC mezi plátci = § 92a ZDPH; přeshraniční plnění (klient mimo CZ,
     vč. faktur identifikované osoby do EU) = čl. 196 směrnice 2006/112/ES. #}
  {% if client.country_iso2|default('CZ') == 'CZ' %}
  {{ t('Daň odvede zákazník (přenesená daňová povinnost dle § 92a zákona o DPH).',
       'Reverse charge — VAT to be accounted for by the customer.') }}
  {% else %}
  {{ t('Daň odvede zákazník (přenesení daňové povinnosti dle čl. 196 směrnice 2006/112/ES).',
       'Reverse charge — VAT to be accounted for by the customer pursuant to Article 196 of Council Directive 2006/112/EC.') }}
  {% endif %}
</div>
{% endif %}

{# ─── OSS DOLOŽKA ───
   Doklad s řádky v režimu jednoho správního místa nese sazbu státu spotřeby. Bez téhle
   věty ji příjemce ani jeho účetní nemá jak odlišit od české daně ve špatné sazbě —
   doložka je protějškem RC klauzule výše. Podklad staví OssInvoiceClause (SSOT sdílený
   s veřejným HTML náhledem).
   Doklad se smíšeným plněním (část tuzemská, část OSS) dostane opatrnější formulaci —
   tvrdit u něj, že daň je odvedena ve státě spotřeby, by platilo jen o části řádků.
   Státy spotřeby se vypisují všechny; seznam je buď úplný, nebo (u řádku bez země)
   prázdný a věta státy nejmenuje — neúplný výčet by na dokladu lhal. #}
{% if oss_clause %}
<div class="note oss-note">
  {% if oss_clause.all_items %}
  {{ t('Daň je přiznána a odvedena ve státě spotřeby v režimu jednoho správního místa (One Stop Shop) podle § 110a a násl. zákona o DPH.',
       'VAT is declared and paid in the Member State of consumption under the One Stop Shop scheme pursuant to Articles 369a et seq. of Council Directive 2006/112/EC.') }}
  {% else %}
  {{ t('U položek v režimu jednoho správního místa (One Stop Shop) je daň přiznána a odvedena ve státě spotřeby podle § 110a a násl. zákona o DPH.',
       'For the items covered by the One Stop Shop scheme, VAT is declared and paid in the Member State of consumption pursuant to Articles 369a et seq. of Council Directive 2006/112/EC.') }}
  {% endif %}
  {% if oss_clause.countries is not empty %}
    {#- Řízení bílých znaků (`{%-`) drží popisek a výčet států na jednom řádku —
        bez něj mPDF vysází „Stát spotřeby:" a název státu s mezerou navíc. -#}
    {%- if oss_clause.countries|length > 1 %} {{ t('Státy spotřeby', 'Member States of consumption') }}:
    {%- else %} {{ t('Stát spotřeby', 'Member State of consumption') }}:
    {%- endif %}
    {%- for c in oss_clause.countries %} {{ locale == 'en' ? c.name_en : c.name_cs }}{{ loop.last ? '.' : ',' }}{% endfor %}
  {% endif %}
</div>
{% endif %}

{# ─── QR + SOUČTY ───
   QR vlevo proti částce k úhradě vpravo. Rekapitulace sazeb se nad částku vsune jen
   u plátce — u neplátce zbude jediný řádek, přesně jak má doklad neplátce vypadat. #}
<table class="totals">
  <tr>
    <td class="left">
      {% if qr_data_uri %}
      {# mPDF ignoruje rozměry obrázku ze stylopisu — musí být INLINE (issue #37). #}
      <table class="qr-box">
        <tr><td>
          <img src="{{ qr_data_uri }}" alt="QR" style="width: 32mm; height: 32mm;">
          <div class="qr-caption">{{ t('QR Platba', 'QR Payment') }}</div>
        </td></tr>
      </table>
      {% endif %}
    </td>
    <td class="right">
      {% set _has_recap_rows = (supplier.is_vat_payer and invoice.invoice_type != 'proforma' and invoice.vat_breakdown|length > 0)
            or invoice.advance_paid_amount > 0
            or ((invoice.paid_total ?? 0) > 0 and invoice.status != 'paid') %}
      {% if _has_recap_rows %}
      <table class="vat-recap">
        {% if supplier.is_vat_payer and invoice.invoice_type != 'proforma' %}
        {% for b in invoice.vat_breakdown %}
        <tr>
          <td class="recap-label">{{ t('Základ', 'Base') }} {{ b.rate|number_format(b.rate == b.rate|round(0) ? 0 : 2, decimal_sep, thousand_sep) }}&nbsp;%</td>
          <td class="recap-value">{{ b.base|number_format(2, decimal_sep, thousand_sep) }}</td>
        </tr>
        {% if b.vat > 0 %}
        <tr>
          <td class="recap-label">{{ t('DPH', 'VAT') }} {{ b.rate|number_format(b.rate == b.rate|round(0) ? 0 : 2, decimal_sep, thousand_sep) }}&nbsp;%</td>
          <td class="recap-value">{{ b.vat|number_format(2, decimal_sep, thousand_sep) }}</td>
        </tr>
        {% endif %}
        {% endfor %}
        {# Souhrn jen při více sazbách; u jediné sazby by jen zopakoval řádky výše. #}
        {% if invoice.vat_breakdown|length > 1 %}
        <tr class="recap-sum">
          <td class="recap-label">{{ t('Celkem bez DPH', 'Total without VAT') }}</td>
          <td class="recap-value">{{ invoice.totals.without_vat|number_format(2, decimal_sep, thousand_sep) }}</td>
        </tr>
        <tr class="recap-sum-cont">
          <td class="recap-label">{{ t('DPH celkem', 'Total VAT') }}</td>
          <td class="recap-value">{{ invoice.totals.vat|number_format(2, decimal_sep, thousand_sep) }}</td>
        </tr>
        {% endif %}
        {% endif %}

        {% if invoice.advance_paid_amount > 0 %}
        <tr class="recap-sum">
          <td class="recap-label">{{ t('Celkem', 'Total') }}</td>
          <td class="recap-value">{{ invoice.totals.with_vat|number_format(2, decimal_sep, thousand_sep) }}</td>
        </tr>
        <tr class="advance">
          {% if invoice.invoice_type == 'tax_document' %}
          {# Daňový doklad k přijaté platbě — „záloha" je sama přijatá platba. #}
          <td class="recap-label">{{ t('Uhrazeno přijatou platbou', 'Settled by payment received') }}</td>
          {% else %}
          <td class="recap-label">{{ t('Odečet zálohy', 'Advance deduction') }}</td>
          {% endif %}
          <td class="recap-value">−{{ invoice.advance_paid_amount|number_format(2, decimal_sep, thousand_sep) }}</td>
        </tr>
        {% endif %}

        {# Částečné úhrady (#89): evidované platby snižují výzvu k platbě — znovu
           stažené PDF nesmí chtít celou částku (QR výše zní na tentýž zbytek). #}
        {% if (invoice.paid_total ?? 0) > 0 and invoice.status != 'paid' %}
        <tr class="recap-sum">
          <td class="recap-label">{{ t('Celkem', 'Total') }}</td>
          <td class="recap-value">{{ invoice.amount_to_pay|number_format(2, decimal_sep, thousand_sep) }}</td>
        </tr>
        <tr class="advance">
          <td class="recap-label">{{ t('Uhrazeno', 'Paid to date') }}</td>
          <td class="recap-value">−{{ invoice.paid_total|number_format(2, decimal_sep, thousand_sep) }}</td>
        </tr>
        {% endif %}
      </table>
      {% endif %}

      {# Částka k úhradě = zbytek po odečtu evidovaných plateb; tutéž částku nese QR
         výše (InvoicePdfRenderer ji počítá ze stejného zdroje). U UHRAZENÉHO dokladu
         by ale zbytek byl nula — tam se tiskne celá uhrazená částka, protože popisek
         nad ní zní „Celkem uhrazeno", ne „zbývá". #}
      {% set _due = is_paid ? invoice.amount_to_pay : invoice.amount_to_pay - (invoice.paid_total ?? 0) %}
      <table class="sum-total">
        <tr>
          <td class="sum-label">
            {#- Dobropis se nehradí, vrací — „k úhradě" by u záporné částky mátlo. -#}
            {%- if invoice.invoice_type == 'credit_note' -%}{{ t('Celkem k vrácení', 'Total to be refunded') }}
            {%- elseif is_paid -%}{{ t('Celkem uhrazeno', 'Total paid') }}
            {%- elseif (invoice.paid_total ?? 0) > 0 -%}{{ t('Zbývá uhradit', 'Remaining due') }}
            {%- else -%}{{ t('Celkem k úhradě', 'Total due') }}{%- endif -%}:
          </td>
          <td class="sum-value">{{ _due|number_format(2, decimal_sep, thousand_sep) }}&nbsp;{{ currency_symbol }}</td>
        </tr>
      </table>

      {% if invoice.czk_recap and not hide_pdf_czk_recap %}
      <div class="rate-note">
        {{ t('Kurz ČNB', 'CNB rate') }}:
        {{ invoice.czk_recap.rate|number_format(3, decimal_sep, thousand_sep) }}&nbsp;CZK / 1&nbsp;{{ invoice.currency }}
        ({{ invoice.czk_recap.rate_date }})
      </div>
      {% endif %}

      {# Doklad v cizí měně pro tuzemského odběratele musí uvést DPH v CZK (§ 37 ZDPH),
         i když se rekapitulace přepočtu netiskne. #}
      {% for b in pdf_czk_vat %}
      <div class="vat-czk-required">
        {{ t('DPH v CZK', 'VAT in CZK') }}
        ({{ b.rate|number_format(b.rate == b.rate|round(0) ? 0 : 2, decimal_sep, thousand_sep) }}&nbsp;%):
        {{ b.vat_czk|number_format(2, decimal_sep, thousand_sep) }}&nbsp;CZK
      </div>
      {% endfor %}
    </td>
  </tr>
</table>

{# ─── PŘEPOČET DO CZK (cizí měna) ─── #}
{% if invoice.czk_recap and not hide_pdf_czk_recap %}
<div class="czk-recap">
  <div class="czk-recap-title">
    {{ t('Přepočet do CZK', 'Conversion to CZK') }}
    <span class="czk-recap-rate">
      ({{ t('kurz ČNB', 'CNB rate') }}
      {{ invoice.czk_recap.rate|number_format(3, decimal_sep, thousand_sep) }}&nbsp;CZK / 1&nbsp;{{ invoice.currency }},
      {{ invoice.czk_recap.rate_date }})
    </span>
  </div>
  <table class="vat-recap">
    {% if supplier.is_vat_payer and invoice.invoice_type != 'proforma' %}
    {% for b in invoice.czk_recap.breakdown %}
    <tr>
      <td class="recap-label">{{ t('Základ', 'Base') }} {{ b.rate|number_format(b.rate == b.rate|round(0) ? 0 : 2, decimal_sep, thousand_sep) }}&nbsp;%</td>
      <td class="recap-value">{{ b.base_czk|number_format(2, decimal_sep, thousand_sep) }}&nbsp;CZK</td>
    </tr>
    {% if b.vat_czk > 0 %}
    <tr>
      <td class="recap-label">{{ t('DPH', 'VAT') }} {{ b.rate|number_format(b.rate == b.rate|round(0) ? 0 : 2, decimal_sep, thousand_sep) }}&nbsp;%</td>
      <td class="recap-value">{{ b.vat_czk|number_format(2, decimal_sep, thousand_sep) }}&nbsp;CZK</td>
    </tr>
    {% endif %}
    {% endfor %}
    {% endif %}
    <tr class="recap-sum">
      <td class="recap-label">{{ t('Celkem', 'Total') }}</td>
      <td class="recap-value">{{ invoice.czk_recap.total_with_vat_czk|number_format(2, decimal_sep, thousand_sep) }}&nbsp;CZK</td>
    </tr>
  </table>
</div>
{% endif %}

{# ─── ROZPIS PLATEB (§ 31a ZDPH) ───
   Právě tenhle rozpis dělá z platebního kalendáře daňový doklad. Bez něj se doklad
   tiskl jako běžná faktura s jediným datem splatnosti — tedy bez toho jediného, kvůli
   čemu vzniká. Kalendář BEZ rozpisu se ani nedá vystavit (validace při vystavení), takže
   prázdná tabulka tady znamená doklad v konceptu; vypíše se proto věta, ne prázdný rám. #}
{% if invoice.invoice_type == 'payment_calendar' %}
<div class="schedule-title">
  {{ t('Rozpis plateb', 'Payment schedule') }}
  <span class="schedule-legal">{{ t('§ 31a zákona o DPH', 'Section 31a of the Czech VAT Act') }}</span>
</div>
<table class="schedule-table">
  {% if payment_schedule is empty %}
  <tr>
    <td colspan="5" class="schedule-empty">
      {{ t('Rozpis plateb zatím není vyplněn.', 'The payment schedule has not been filled in yet.') }}
    </td>
  </tr>
  {% else %}
  <tr class="schedule-head">
    <th class="schedule-th">{{ t('Splatnost', 'Due date') }}</th>
    <th class="schedule-th right">{{ t('Základ', 'Base') }}</th>
    <th class="schedule-th right">{{ t('DPH', 'VAT') }}</th>
    <th class="schedule-th right">{{ t('Celkem', 'Total') }}</th>
    <th class="schedule-th">{{ t('Poznámka', 'Note') }}</th>
  </tr>
  {% for row in payment_schedule %}
  <tr>
    <td class="schedule-td nowrap">{{ row.due_on|date(date_format) }}</td>
    <td class="schedule-td right nowrap">{{ row.base_amount|number_format(2, decimal_sep, thousand_sep) }}</td>
    <td class="schedule-td right nowrap">{{ row.vat_amount|number_format(2, decimal_sep, thousand_sep) }}</td>
    <td class="schedule-td right nowrap">{{ row.total_amount|number_format(2, decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
    <td class="schedule-td">{{ row.note }}</td>
  </tr>
  {% endfor %}
  <tr class="schedule-total">
    <td class="schedule-td">{{ t('Celkem za období', 'Total for the period') }}</td>
    <td class="schedule-td right nowrap">{{ payment_schedule|reduce((s, r) => s + r.base_amount, 0)|number_format(2, decimal_sep, thousand_sep) }}</td>
    <td class="schedule-td right nowrap">{{ payment_schedule|reduce((s, r) => s + r.vat_amount, 0)|number_format(2, decimal_sep, thousand_sep) }}</td>
    <td class="schedule-td right nowrap">{{ payment_schedule|reduce((s, r) => s + r.total_amount, 0)|number_format(2, decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
    <td class="schedule-td"></td>
  </tr>
  {% endif %}
</table>
<div class="note schedule-note">
  {{ t('Každá platba uvedená v rozpisu je samostatným zdanitelným plněním; daň se uplatní ke dni její splatnosti nebo přijetí úplaty podle toho, který nastane dříve.',
       'Each payment listed in the schedule is a separate taxable supply; VAT applies on its due date or on receipt of payment, whichever occurs first.') }}
</div>
{% endif %}

{% if invoice.note_below_items %}
<div class="note note-below">{{ invoice.note_below_items|nl2br }}</div>
{% endif %}

{% if invoice.invoice_type == 'proforma' %}
<div class="note proforma-note">
  {{ t('Nejedná se o daňový doklad, ten bude vystaven po připsání platby.',
       'This is not a tax document. The tax document will be issued after payment is received.') }}
</div>
{% endif %}

{# ─── VÝKAZ VÍCEPRACÍ + VÝKAZ MATERIÁLU — 2. stránka ─── #}
{% set _has_work = work_report and (work_report.items|length) > 0 %}
{% set _has_material = work_report and work_report.material_total > 0 and (work_report.materials|default([])|length) > 0 %}
{% if _has_work or _has_material %}
{% set wr_has_dates = _has_work and (work_report.items|filter(it => it.work_date)|length) > 0 %}
{# Desetinná místa per sloupec: skryj „,00" jen když jsou VŠECHNY hodnoty ve sloupci celé. #}
{% set hours_dec = (_has_work and (work_report.items|filter(it => it.hours != it.hours|round(0))|length) > 0) ? 2 : 0 %}
{% set rate_dec  = (_has_work and (work_report.items|filter(it => it.rate != it.rate|round(0))|length) > 0) ? 2 : 0 %}
{% set total_dec = (_has_work and (work_report.items|filter(it => it.total_amount != it.total_amount|round(0))|length) > 0) ? 2 : 0 %}
{% set _doc_type = (_has_work and _has_material)
      ? t('Výkaz prací a materiálu', 'Work & material report')
      : (_has_work ? t('Výkaz víceprací', 'Work report') : t('Výkaz materiálu', 'Material report')) %}
<div class="page-break"></div>

<table class="head">
  <tr>
    <td class="head-left">
      <div class="party-label">{{ t('Dodavatel', 'Supplier') }}</div>
      <div class="party-name">{{ supplier.company_name }}</div>
      <div>{{ supplier.street }}</div>
      <div>{{ supplier.zip }} {{ supplier.city }}</div>
    </td>
    <td class="head-right">
      <table class="doc-title">
        <tr>
          <td><div class="doc-type">{{ _doc_type }}</div></td>
          <td class="doc-number">
            {% if invoice.varsymbol %}
            <table class="num-box"><tr><td>{{ invoice.varsymbol }}</td></tr></table>
            {% endif %}
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<div class="wr-meta">
  <div class="wr-title">{{ work_report.title }}</div>
  {{ t('K faktuře', 'For invoice') }} {{ invoice.varsymbol }}
  {%- if invoice.project_name %} · {{ t('Zakázka', 'Project') }}: {{ invoice.project_name }}{% endif %}
</div>

{% if _has_work %}
{# Cíl interního odkazu z položky práce ve faktuře (mPDF named destination). #}
<a name="work-report"></a>
<table class="items">
  <thead>
    <tr>
      <th style="width:{% if wr_has_dates %}43%{% else %}55%{% endif %}">{{ t('Popis', 'Description') }}</th>
      {% if wr_has_dates %}<th class="nowrap" style="width:12%">{{ t('Datum', 'Date') }}</th>{% endif %}
      <th class="num nowrap" style="width:13%">{{ t('Hodiny', 'Hours') }}</th>
      <th class="num nowrap" style="width:14%">{{ t('Sazba', 'Rate') }}</th>
      <th class="num nowrap" style="width:18%">{{ t('Celkem', 'Total') }}</th>
    </tr>
  </thead>
  <tbody>
    {% for it in work_report.items %}
    <tr>
      <td>{{ it.description|nl2br }}</td>
      {% if wr_has_dates %}<td class="nowrap">{% if it.work_date %}{{ it.work_date|date(date_format) }}{% endif %}</td>{% endif %}
      <td class="num nowrap">{% if it.duration_display is defined and it.duration_display is not null %}{{ it.duration_display }}{% else %}{{ it.hours|number_format(hours_dec, decimal_sep, thousand_sep) }}{% endif %}</td>
      <td class="num nowrap">{{ it.rate|number_format(it.rate_decimals|default(rate_dec), decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
      <td class="num nowrap">{{ it.total_amount|number_format(total_dec, decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
    </tr>
    {% endfor %}
    <tr class="items-sum">
      <td class="right" {% if wr_has_dates %}colspan="2"{% endif %}>{{ t('Celkem', 'Total') }}</td>
      <td class="num nowrap">{% if work_report.total_duration_display is defined and work_report.total_duration_display is not null %}{{ work_report.total_duration_display }}{% else %}{{ work_report.total_hours|number_format(hours_dec, decimal_sep, thousand_sep) }}{% endif %} h</td>
      <td></td>
      <td class="num nowrap">{{ work_report.total_amount|number_format(total_dec, decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
    </tr>
  </tbody>
</table>
{% endif %}

{% if _has_material %}
{% set qty_dec    = (work_report.materials|filter(m => m.quantity != m.quantity|round(0))|length) > 0 ? 3 : 0 %}
{% set mprice_dec = (work_report.materials|filter(m => m.unit_price != m.unit_price|round(0))|length) > 0 ? 2 : 0 %}
{% set mtotal_dec = (work_report.materials|filter(m => m.total_amount != m.total_amount|round(0))|length) > 0 ? 2 : 0 %}
{# Cíl interního odkazu z položky materiálu ve faktuře (mPDF named destination). #}
<a name="work-report-material"></a>
<div class="wr-section">{{ work_report.material_title|default(t('Materiál', 'Material')) }}</div>
<table class="items">
  <thead>
    <tr>
      <th style="width:52%">{{ t('Popis', 'Description') }}</th>
      <th class="num nowrap" style="width:13%">{{ t('Množství', 'Quantity') }}</th>
      <th class="nowrap" style="width:9%">{{ t('MJ', 'Unit') }}</th>
      <th class="num nowrap" style="width:13%">{{ t('Cena/MJ', 'Unit price') }}</th>
      <th class="num nowrap" style="width:13%">{{ t('Celkem', 'Total') }}</th>
    </tr>
  </thead>
  <tbody>
    {% for m in work_report.materials %}
    <tr>
      <td>{{ m.description|nl2br }}</td>
      <td class="num nowrap">{{ m.quantity|number_format(qty_dec, decimal_sep, thousand_sep) }}</td>
      <td class="nowrap">{{ m.unit }}</td>
      <td class="num nowrap">{{ m.unit_price|number_format(mprice_dec, decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
      <td class="num nowrap">{{ m.total_amount|number_format(mtotal_dec, decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
    </tr>
    {% endfor %}
    <tr class="items-sum">
      <td class="right" colspan="4">{% if supplier.is_vat_payer %}{{ t('Celkem bez DPH', 'Total excl. VAT') }}{% else %}{{ t('Celkem', 'Total') }}{% endif %}</td>
      <td class="num nowrap">{{ work_report.material_total|number_format(supplier.is_vat_payer ? 2 : mtotal_dec, decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
    </tr>
    {% if supplier.is_vat_payer %}
    <tr class="items-sum">
      <td class="right" colspan="4">{{ t('Celkem s DPH', 'Total incl. VAT') }}{% if work_report.material_vat_rate is not null %} ({{ work_report.material_vat_rate|number_format(work_report.material_vat_rate == work_report.material_vat_rate|round(0) ? 0 : 2, decimal_sep, thousand_sep) }}&nbsp;%){% endif %}</td>
      <td class="num nowrap">{{ work_report.material_total_with_vat|number_format(2, decimal_sep, thousand_sep) }} {{ invoice.currency }}</td>
    </tr>
    {% endif %}
  </tbody>
</table>
{% endif %}
{% endif %}

</body>
</html>
