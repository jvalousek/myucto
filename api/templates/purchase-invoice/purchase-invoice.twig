{# MyInvoice.cz — PDF šablona PŘIJATÉ faktury (mPDF + Twig) #}
{# Variables: invoice, vendor, our_company, items, totals, currency, doc_type_label, locale #}
{#
   Rekonstrukce dokladu od dodavatele. Sází se stejným stylopisem jako vystavená
   faktura (styles/invoice.css), aby složka dokladů držela jeden vizuální jazyk —
   ale badge „Rekonstrukce" musí být vidět: závazný je originál od dodavatele.

   Šablona nemá k dispozici Twig funkci `t()` (ta patří renderu vystavené faktury),
   překlady proto jedou přes `locale`.
#}
<!doctype html>
<html lang="{{ locale|default('cs') }}">
<head>
<meta charset="utf-8">
<title></title>
<style>{{ css|raw }}</style>
</head>
<body>

{% set currency_symbols = {'CZK': 'Kč', 'EUR': '€', 'USD': '$', 'GBP': '£', 'PLN': 'zł', 'HUF': 'Ft'} %}
{% set currency_symbol = currency_symbols[currency]|default(currency) %}

{# ─── PATIČKA (každá stránka) ─── #}
<htmlpagefooter name="docfooter">
  <table class="doc-footer">
    <tr>
      <td class="footer-attribution">
        <span class="page-attribution">
          {%- if locale == 'en' -%}
            Reconstruction generated by <a href="https://myucto.cz/">MyÚčto.cz</a> — the original from the vendor is the authoritative document
          {%- else -%}
            Rekonstrukce vygenerována systémem <a href="https://myucto.cz/">MyÚčto.cz</a> — závazný je originál od dodavatele
          {%- endif -%}
        </span>
      </td>
      <td class="footer-page">{% if locale == 'en' %}Page{% else %}Strana{% endif %} {PAGENO}/{nbpg}</td>
    </tr>
  </table>
</htmlpagefooter>
<sethtmlpagefooter name="docfooter" value="on" />

{# ─── HLAVIČKA + STRANY ─── #}
<table class="head">
  <tr>
    <td class="head-left">
      <div class="reconstruction-badge">{% if locale == 'en' %}Reconstruction{% else %}Rekonstrukce{% endif %}</div>
      <div class="party-label">{% if locale == 'en' %}Supplier (vendor){% else %}Dodavatel{% endif %}</div>
      <div class="party-name">{{ vendor.company_name }}</div>
      <div>{{ vendor.street }}</div>
      <div>{{ vendor.zip }} {{ vendor.city }}</div>
      <div>{{ vendor.country_iso2 }}</div>
      <div class="spacer-4">&nbsp;</div>
      <div class="ic-dic">
        {# Národní daňové číslo dodavatele (#120): SK DIČ / DE+AT Steuernummer / PL NIP /
           HU Adószám s nativním labelem; `dic` = VAT ID s prefixem (u SK = IČ DPH).
           Starší snapshoty tax_number nemají → u SK odvození z IČ DPH oseknutím prefixu. #}
        {% set tax_no_labels = {'SK': 'DIČ', 'DE': 'Steuernummer', 'AT': 'Steuernummer', 'PL': 'NIP', 'HU': 'Adószám'} %}
        {% set vendor_dic_sk = vendor.dic and (vendor.dic|upper starts with 'SK') %}
        {% set vendor_tax_no = vendor.tax_number|default(vendor_dic_sk ? vendor.dic|slice(2) : '') %}
        {% if vendor.ic %}{% if locale == 'en' %}Reg. No.{% else %}IČ{% endif %}: {{ vendor.ic }}{% endif %}
        {% if vendor_tax_no %}
          <span class="dic-gap">{{ tax_no_labels[vendor.country_iso2|default('')]|default(vendor_dic_sk ? 'DIČ' : (locale == 'en' ? 'Tax No.' : 'Daňové číslo')) }}: {{ vendor_tax_no }}</span>
          {%- if vendor.dic %}<br>{% endif %}
        {% endif %}
        {% if vendor.dic %}
          <span class="dic-gap">{% if vendor_dic_sk %}{{ locale == 'en' ? 'VAT ID' : 'IČ DPH' }}{% else %}{{ locale == 'en' ? 'VAT ID' : 'DIČ' }}{% endif %}: {{ vendor.dic }}</span>
        {% endif %}
      </div>
    </td>

    <td class="head-right">
      <table class="doc-title">
        <tr>
          <td><div class="doc-type">{{ doc_type_label }}</div></td>
          <td class="doc-number">
            {% if invoice.vendor_invoice_number %}
            <table class="num-box"><tr><td>{{ invoice.vendor_invoice_number }}</td></tr></table>
            {% endif %}
            {% if invoice.varsymbol %}
              <div class="parent-ref">{% if locale == 'en' %}our ref{% else %}naše ozn.{% endif %}: {{ invoice.varsymbol }}</div>
            {% endif %}
          </td>
        </tr>
      </table>

      <div class="head-gap">&nbsp;</div>

      <div class="party-label">{% if locale == 'en' %}Customer (us){% else %}Odběratel (my){% endif %}</div>
      <div class="party-name">{{ our_company.company_name }}</div>
      <div>{{ our_company.street }}</div>
      <div>{{ our_company.zip }} {{ our_company.city }}</div>
      <div>{{ our_company.country_iso2 }}</div>
      <div class="spacer-4">&nbsp;</div>
      <div class="ic-dic">
        {% if our_company.ic %}{% if locale == 'en' %}Reg. No.{% else %}IČ{% endif %}: {{ our_company.ic }}{% endif %}
        {% if our_company.dic %}
          {% if our_company.dic|upper starts with 'SK' %}
            <span class="dic-gap">{% if locale == 'en' %}Tax ID{% else %}DIČ{% endif %}: {{ our_company.dic|slice(2) }}</span><br>
            {% if locale == 'en' %}VAT ID{% else %}IČ DPH{% endif %}: {{ our_company.dic }}
          {% else %}
            <span class="dic-gap">{% if locale == 'en' %}VAT ID{% else %}DIČ{% endif %}: {{ our_company.dic }}</span>
          {% endif %}
        {% endif %}
      </div>
    </td>
  </tr>
</table>

{# ─── DATA DOKLADU ─── #}
<table class="payband">
  <tr>
    <td class="payband-bank">
      <div class="payband-title">{% if locale == 'en' %}Dates{% else %}Datum{% endif %}</div>
      <table class="payband-pairs">
        <tr>
          <td class="pair-label">{% if locale == 'en' %}issued{% else %}vystavení{% endif %}:</td>
          <td class="pair-value">{{ invoice.issue_date|date('j. n. Y') }}</td>
        </tr>
        <tr>
          <td class="pair-label">{% if locale == 'en' %}tax point{% else %}DUZP{% endif %}:</td>
          <td class="pair-value">{% if invoice.tax_date %}{{ invoice.tax_date|date('j. n. Y') }}{% else %}—{% endif %}</td>
        </tr>
        <tr>
          <td class="pair-label">{% if locale == 'en' %}due{% else %}splatnost{% endif %}:</td>
          <td class="pair-value">{% if invoice.due_date %}{{ invoice.due_date|date('j. n. Y') }}{% else %}—{% endif %}</td>
        </tr>
      </table>
    </td>
    <td class="payband-symbol">
      <div class="payband-title">{% if locale == 'en' %}Symbol{% else %}Symbol{% endif %}</div>
      <table class="payband-pairs">
        {% if invoice.varsymbol %}
        <tr>
          <td class="pair-label">{% if locale == 'en' %}variable{% else %}variabilní{% endif %}:</td>
          <td class="pair-value">{{ invoice.varsymbol }}</td>
        </tr>
        {% endif %}
        <tr>
          <td class="pair-label">{% if locale == 'en' %}currency{% else %}měna{% endif %}:</td>
          <td class="pair-value">{{ currency }}</td>
        </tr>
      </table>
    </td>
    <td class="payband-date">
      <div class="payband-title">{% if locale == 'en' %}Vendor{% else %}Dodavatel{% endif %}</div>
      <div class="payband-note">{{ vendor.company_name }}</div>
    </td>
  </tr>
</table>

{% if invoice.reverse_charge %}
<div class="note rc-note">
  {% if locale == 'en' %}Reverse charge — VAT to be accounted for by the customer.{% else %}Daň odvádí zákazník (přenesená daňová povinnost).{% endif %}
</div>
{% endif %}

{% if invoice.note_above_items %}
<div class="note note-above">{{ invoice.note_above_items|nl2br }}</div>
{% endif %}

{# ─── POLOŽKY ─── #}
<table class="items">
  <thead>
    <tr>
      <th style="width:50%">{% if locale == 'en' %}Description{% else %}Označení dodávky{% endif %}</th>
      <th class="num nowrap" style="width:10%">{% if locale == 'en' %}Qty{% else %}Počet{% endif %}</th>
      <th class="nowrap" style="width:6%">{% if locale == 'en' %}unit{% else %}m. j.{% endif %}</th>
      <th class="num nowrap" style="width:14%">{% if locale == 'en' %}Unit price{% else %}Cena za m.j.{% endif %}</th>
      <th class="center nowrap" style="width:6%">DPH</th>
      <th class="num nowrap" style="width:14%">{% if invoice.prices_include_vat %}{% if locale == 'en' %}Total inc. VAT{% else %}Celkem s DPH{% endif %}{% else %}{% if locale == 'en' %}Total ex. VAT{% else %}Celkem bez DPH{% endif %}{% endif %}</th>
    </tr>
  </thead>
  <tbody>
    {% for item in items %}
    <tr>
      <td>{{ item.description }}</td>
      <td class="num nowrap">{% if item.duration_display is defined and item.duration_display is not null %}{{ item.duration_display }}{% else %}{{ item.quantity|number_format(4, ',', ' ') }}{% endif %}</td>
      <td class="nowrap">{{ item.unit|default('ks') }}</td>
      <td class="num nowrap">{{ item.pdf_unit_price|default(item.unit_price_without_vat)|number_format(4, ',', ' ') }}</td>
      <td class="center nowrap">{{ item.vat_rate|number_format(0) }}&nbsp;%</td>
      <td class="num nowrap amount">{{ item.line_total|number_format(2, ',', ' ') }}</td>
    </tr>
    {% else %}
    <tr><td colspan="6">{% if locale == 'en' %}No items{% else %}Žádné položky{% endif %}</td></tr>
    {% endfor %}
  </tbody>
</table>

{# ─── SOUČTY ─── #}
{% set rnd = invoice.rounding|default(0) %}
<table class="totals">
  <tr>
    <td class="left"></td>
    <td class="right">
      <table class="vat-recap">
        <tr>
          <td class="recap-label">{% if locale == 'en' %}Subtotal{% else %}Celkem bez DPH{% endif %}</td>
          <td class="recap-value">{{ totals.without_vat|number_format(2, ',', ' ') }}</td>
        </tr>
        <tr>
          <td class="recap-label">{% if locale == 'en' %}VAT total{% else %}DPH celkem{% endif %}</td>
          <td class="recap-value">{{ totals.vat|number_format(2, ',', ' ') }}</td>
        </tr>
        {% if rnd != 0 %}
        <tr class="recap-sum">
          <td class="recap-label">{% if locale == 'en' %}Total inc. VAT{% else %}Celkem s DPH{% endif %}</td>
          <td class="recap-value">{{ totals.with_vat|number_format(2, ',', ' ') }}</td>
        </tr>
        <tr>
          <td class="recap-label">{% if locale == 'en' %}Rounding{% else %}Zaokrouhlení{% endif %}</td>
          <td class="recap-value">{{ rnd|number_format(2, ',', ' ') }}</td>
        </tr>
        {% endif %}
      </table>
      <table class="sum-total">
        <tr>
          <td class="sum-label">{% if locale == 'en' %}Total due{% else %}Celkem k úhradě{% endif %}:</td>
          <td class="sum-value">{{ (totals.with_vat + rnd)|number_format(2, ',', ' ') }}&nbsp;{{ currency_symbol }}</td>
        </tr>
      </table>
    </td>
  </tr>
</table>

{% if invoice.note_below_items %}
<div class="note note-below">{{ invoice.note_below_items|nl2br }}</div>
{% endif %}

</body>
</html>
